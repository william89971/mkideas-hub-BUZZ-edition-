{
  "$schema": "https://open-plugin-spec.org/schema/v1/plugin.json",
  "id": "org.mkideas.v0-agents",
  "name": "MK Ideas Agents",
  "version": "0.2.0",
  "description": "Five human-gated operational personas for MK Ideas Buzz, with deterministic v2 contract fixtures.",
  "author": "MK Ideas",
  "license": "Apache-2.0",
  "keywords": ["mkideas", "research", "interviews", "operations", "human-review"],
  "personas": [
    "agents/guest-researcher.persona.md",
    "agents/outreach-drafter.persona.md",
    "agents/interview-producer.persona.md",
    "agents/content-clip-copilot.persona.md",
    "agents/operations-briefing-assistant.persona.md"
  ],
  "pack_instructions": "instructions.md",
  "defaults": {
    "temperature": 0.3,
    "triggers": {
      "mentions": true,
      "keywords": [],
      "all_messages": false
    },
    "thread_replies": true,
    "broadcast_replies": false
  }
}
