# MK Ideas Buzz deployment configuration. Copy to .env and fill only non-secret
# deployment values. Secret bytes belong in MKIDEAS_SECRETS_DIR; see secrets/README.md.

COMPOSE_PROJECT_NAME=mkideas-buzz
MKIDEAS_DOMAIN=hub.example.invalid
MKIDEAS_SECRETS_DIR=./secrets

# William's public Nostr key, as exactly 64 hexadecimal characters. This is
# public identity material, not a private key or secret. The relay bootstraps it
# as the owner and rejects non-members in the production profile.
RELAY_OWNER_PUBKEY=REPLACE_WITH_WILLIAM_64_HEX_PUBLIC_KEY

# Fork-owned, immutable image references are required for every executable MK
# service. Use registry.example.invalid only as a marker until CI publishes the
# real digest-pinned images.
MKIDEAS_RELAY_IMAGE=registry.example.invalid/mkideas/relay@sha256:REPLACE_WITH_64_HEX
MKIDEAS_AGENT_IMAGE=registry.example.invalid/mkideas/agent@sha256:REPLACE_WITH_64_HEX
MKIDEAS_PUSH_IMAGE=registry.example.invalid/mkideas/push-gateway@sha256:REPLACE_WITH_64_HEX

POSTGRES_DB=mkideas
POSTGRES_USER=mkideas
BUZZ_S3_BUCKET=mkideas-private-media
BUZZ_S3_REGION=us-east-1
BUZZ_AUTO_MIGRATE=false
BUZZ_PUSH_ENABLED=false
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info

# Monitoring UIs bind only to loopback by default. Reach them through an SSH
# tunnel or a separately approved private access layer.
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_BIND=127.0.0.1
ALERTMANAGER_PORT=9093

# Off-server, encrypted Restic repository. Leave the example invalid until a
# destination and restricted credentials are separately provisioned.
RESTIC_REPOSITORY=s3:https://backup.example.invalid/mkideas-buzz

# Push remains disabled until APNs/FCM accounts, application identifiers,
# certificates, spending, and privacy review are separately approved.
MKIDEAS_APNS_APP_ID=REPLACE_AFTER_APPROVAL
MKIDEAS_APNS_TOPIC=REPLACE_AFTER_APPROVAL
MKIDEAS_APNS_ENVIRONMENT=sandbox
